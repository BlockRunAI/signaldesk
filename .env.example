BLOCKRUN_API_KEY=
TYPESAFE_API_KEY=
# Choose twitterapi or x. No X account cookies are required.
TWITTERAPI_KEY=
X_BEARER_TOKEN=
# Text generation: blockrun (default) or custom (OpenAI-compatible Chat Completions).
CHAT_PROVIDER=blockrun
# For custom, set all three. Include the API prefix, e.g. /v1.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# BlockRun is optional with custom + a product brief + X/TwitterAPI.io/import.
# Model overrides for the BlockRun and official Jev routes:
CHAT_MODEL=openai/gpt-4o-mini
JEV_MODEL=jev-1.13.0
